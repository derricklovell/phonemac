 "blocks": [
  {
   "lesson_id": 103,
   "kind": "heading",
   "body": "Start with good paper",
   "material_slug": null,
   "is_gated": false
  },
  {
   "lesson_id": 103,
   "kind": "paragraph",
   "body": "Paper matters more than brushes or paint. Student-grade paints on good paper look better than artist-grade paints on cheap paper, because the paper decides how the water moves.",
   "material_slug": null,
   "is_gated": false
  },
  {
   "lesson_id": 103,
   "kind": "paragraph",
   "body": "For this course, use <b class='a-term' data-push='term' data-id='cold-press'>cold-press paper</b> at <b>140 lb</b> or heavier. It's forgiving, takes washes evenly, and doesn't need stretching for small pieces.",
   "material_slug": null,
   "is_gated": true
  },
  {
   "lesson_id": 103,
   "kind": "figure",
   "body": "",
   "material_slug": "paper-surfaces",
   "is_gated": true
  },
  {
   "lesson_id": 103,
   "kind": "pull",
   "body": "Let the water do some of the work.",
   "material_slug": null,
   "is_gated": true
  },
  {
   "lesson_id": 103,
   "kind": "heading",
   "body": "Brushes and water",
   "material_slug": null,
   "is_gated": true
  },
  {
   "lesson_id": 103,
   "kind": "paragraph",
   "body": "Three brushes are enough: a large round, a small round and a flat. Keep two water jars, one to rinse and one clean, so your colors stay bright.",
   "material_slug": null,
   "is_gated": true
  },
  {
   "lesson_id": 103,
   "kind": "example",
   "body": "",
   "material_slug": "stretch-paper",
   "is_gated": true
  },
  {
   "lesson_id": 103,
   "kind": "paragraph",
   "body": "Before the next lesson, tape a sheet to a board and paint one even stroke of clear water across it. Watch how long it takes to dry.",
   "material_slug": null,
   "is_gated": true
  },
  {
   "lesson_id": 101,
   "kind": "paragraph",
   "body": "Welcome! In this short video we look at everything you'll need for the course, and what you can skip.",
   "material_slug": null,
   "is_gated": false
  },
  {
   "lesson_id": 104,
   "kind": "paragraph",
   "body": "Notes for this lesson: mix more paint than you think you need. A wash that runs dry halfway leaves a hard edge.",
   "material_slug": null,
   "is_gated": false
  }
 ],
